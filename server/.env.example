NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# MySQL / MariaDB connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=home_workout
DB_POOL=10

# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=30d

# Comma separated list, or * for any
CORS_ORIGINS=*

# Groq AI plan generation (keep server-side)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Admin panel login (copy real values into .env; never commit secrets)
ADMIN_EMAIL=
ADMIN_PASSWORD=
