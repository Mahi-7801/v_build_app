{
  "name": "homeworkout-server",
  "version": "1.0.0",
  "private": true,
  "description": "Node.js + MySQL backend for Home Workout - No Equipment (React Native rebuild)",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:migrate": "node scripts/migrate.js",
    "db:payments": "node scripts/migrate_payments.js",
    "db:audio": "node scripts/migrate_exercise_audio.js",
    "db:category": "node scripts/migrate_custom_category.js",
    "db:seed": "node scripts/seed.js",
    "db:reset": "node scripts/migrate.js --fresh && node scripts/seed.js",
    "test": "node --test test/"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=18"
  }
}
