{
  "expo": {
    "name": "V_build",
    "slug": "v-build",
    "scheme": "homeworkout",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#004AFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "homeworkout.homeworkouts.noequipment.rebuild",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#004AFF"
      }
    },
    "ios": {
      "bundleIdentifier": "homeworkout.homeworkouts.noequipment.rebuild",
      "supportsTablet": false
    },
    "plugins": [
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "aadd50a7-1067-44e9-b09e-b8a3a7a192d7"
      }
    },
    "owner": "mahibujjipapa"
  }
}